# Database
DATABASE_URL="postgresql://laixeho:laixeho_secret@localhost:5432/laixeho_db?schema=public"

# Redis
REDIS_HOST="localhost"
REDIS_PORT=6379

# Auth & JWT
JWT_SECRET="change-this-super-secret-jwt-key-in-production"
JWT_EXPIRES_IN="7d"
OTP_TTL_SECONDS=300
OTP_BYPASS_PHONES="0900000001,0900000002"

# Map Provider (mock | goong | google)
MAP_PROVIDER="mock"
GOONG_API_KEY=""
GOOGLE_MAPS_API_KEY=""

# SMS OTP Provider (mock | esms | twilio)
SMS_PROVIDER="mock"
ESMS_API_KEY=""
ESMS_SECRET_KEY=""

# Object Storage (mock | s3 | r2)
STORAGE_PROVIDER="mock"
S3_BUCKET="laixeho-media"
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL="http://localhost:3000/uploads"

# Server
PORT=3000
CORS_ORIGIN="*"
