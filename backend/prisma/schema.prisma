generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DriverStatus {
  PENDING
  ACTIVE
  LOCKED
}

enum TripStatus {
  SEARCHING
  ACCEPTED
  ARRIVED
  IN_PROGRESS
  COMPLETED
  NO_DRIVER
  CANCELLED
}

enum TimeSlot {
  DAY
  NIGHT
}

enum MediaType {
  IMAGE
  VIDEO
}

enum MediaStage {
  PICKUP
  DROPOFF
}

enum OfferResult {
  PENDING
  ACCEPTED
  REJECTED
  TIMEOUT
}

enum WalletTxType {
  TOPUP
  COMMISSION
  ADJUSTMENT
}

enum MaintenanceFeeStatus {
  UNPAID
  PAID
  OVERDUE
}

enum UserType {
  CUSTOMER
  DRIVER
  ADMIN
}

model Customer {
  id         String   @id @default(uuid())
  phone      String   @unique
  name       String?
  fcmToken   String?  @map("fcm_token")
  createdAt  DateTime @default(now()) @map("created_at")

  trips      Trip[]

  @@map("customers")
}

model Driver {
  id           String       @id @default(uuid())
  phone        String       @unique
  name         String?
  avatarUrl    String?      @map("avatar_url")
  idCardUrls   String[]     @default([]) @map("id_card_urls")
  licenseUrls  String[]     @default([]) @map("license_urls")
  status       DriverStatus @default(PENDING)
  isOnline     Boolean      @default(false) @map("is_online")
  lat          Float?
  lng          Float?
  locationAt   DateTime?    @map("location_at")
  lockedUntil  DateTime?    @map("locked_until")
  feeDueDate   DateTime?    @map("fee_due_date")
  fcmToken     String?      @map("fcm_token")
  createdAt    DateTime     @default(now()) @map("created_at")

  wallet          Wallet?
  trips           Trip[]
  dispatchOffers  DispatchOffer[]
  driverLocks     DriverLock[]
  maintenanceFees MaintenanceFee[]

  @@map("drivers")
}

model Admin {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String   @map("password_hash")
  name         String
  role         String   @default("ADMIN")
  createdAt    DateTime @default(now()) @map("created_at")

  createdTrips        Trip[]              @relation("AdminCreatedTrips")
  walletTransactions  WalletTransaction[]
  confirmedFees       MaintenanceFee[]
  auditLogs           AuditLog[]
  updatedSettings     Setting[]

  @@map("admins")
}

model Trip {
  id               String     @id @default(uuid())
  code             String     @unique
  customerId       String     @map("customer_id")
  driverId         String?    @map("driver_id")
  createdByAdminId String?    @map("created_by_admin_id")

  pickupAddress    String     @map("pickup_address")
  pickupLat        Float      @map("pickup_lat")
  pickupLng        Float      @map("pickup_lng")

  dropoffAddress   String?    @map("dropoff_address")
  dropoffLat       Float?     @map("dropoff_lat")
  dropoffLng       Float?     @map("dropoff_lng")

  distanceKm       Float?     @map("distance_km")
  routePolyline    String?    @map("route_polyline")
  timeSlot         TimeSlot   @map("time_slot")
  estimatedPrice   Int?       @map("estimated_price")
  finalPrice       Int?       @map("final_price")
  commissionAmount Int?       @map("commission_amount")
  note             String?

  status           TripStatus @default(SEARCHING)
  orderedAt        DateTime   @default(now()) @map("ordered_at")
  acceptedAt       DateTime?  @map("accepted_at")
  arrivedAt        DateTime?  @map("arrived_at")
  startedAt        DateTime?  @map("started_at")
  completedAt      DateTime?  @map("completed_at")
  cancelledBy      String?    @map("cancelled_by")
  cancelReason     String?    @map("cancel_reason")

  customer           Customer            @relation(fields: [customerId], references: [id])
  driver             Driver?             @relation(fields: [driverId], references: [id])
  createdByAdmin     Admin?              @relation("AdminCreatedTrips", fields: [createdByAdminId], references: [id])
  media              TripMedia[]
  dispatchOffers     DispatchOffer[]
  walletTransactions WalletTransaction[]

  @@index([status])
  @@index([customerId])
  @@index([driverId])
  @@map("trips")
}

model TripMedia {
  id           String     @id @default(uuid())
  tripId       String     @map("trip_id")
  type         MediaType
  stage        MediaStage
  isPlatePhoto Boolean    @default(false) @map("is_plate_photo")
  url          String
  size         Int?
  durationSec  Int?       @map("duration_sec")
  lat          Float?
  lng          Float?
  takenAt      DateTime   @default(now()) @map("taken_at")

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, stage])
  @@map("trip_media")
}

model DispatchOffer {
  id                 String      @id @default(uuid())
  tripId             String      @map("trip_id")
  driverId           String      @map("driver_id")
  distanceToPickupKm Float       @map("distance_to_pickup_km")
  sentAt             DateTime    @default(now()) @map("sent_at")
  expiresAt          DateTime    @map("expires_at")
  result             OfferResult @default(PENDING)

  trip   Trip         @relation(fields: [tripId], references: [id], onDelete: Cascade)
  driver Driver       @relation(fields: [driverId], references: [id])
  locks  DriverLock[]

  @@unique([tripId, driverId])
  @@index([tripId])
  @@map("dispatch_offers")
}

model DriverLock {
  id          String   @id @default(uuid())
  driverId    String   @map("driver_id")
  offerId     String?  @map("offer_id")
  lockedFrom  DateTime @default(now()) @map("locked_from")
  lockedUntil DateTime @map("locked_until")
  reason      String

  driver Driver         @relation(fields: [driverId], references: [id])
  offer  DispatchOffer? @relation(fields: [offerId], references: [id])

  @@index([driverId])
  @@map("driver_locks")
}

model Wallet {
  id        String   @id @default(uuid())
  driverId  String   @unique @map("driver_id")
  balance   Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  driver       Driver              @relation(fields: [driverId], references: [id])
  transactions WalletTransaction[]

  @@map("wallets")
}

model WalletTransaction {
  id           String       @id @default(uuid())
  walletId     String       @map("wallet_id")
  type         WalletTxType
  amount       Int
  balanceAfter Int          @map("balance_after")
  tripId       String?      @map("trip_id")
  adminId      String?      @map("admin_id")
  note         String?
  createdAt    DateTime     @default(now()) @map("created_at")

  wallet Wallet @relation(fields: [walletId], references: [id])
  trip   Trip?  @relation(fields: [tripId], references: [id])
  admin  Admin? @relation(fields: [adminId], references: [id])

  @@index([walletId])
  @@map("wallet_transactions")
}

model MaintenanceFee {
  id                 String               @id @default(uuid())
  driverId           String               @map("driver_id")
  period             String
  amount             Int                  @default(200000)
  dueDate            DateTime             @map("due_date")
  status             MaintenanceFeeStatus @default(UNPAID)
  paidAt             DateTime?            @map("paid_at")
  confirmedByAdminId String?              @map("confirmed_by_admin_id")

  driver           Driver @relation(fields: [driverId], references: [id])
  confirmedByAdmin Admin? @relation(fields: [confirmedByAdminId], references: [id])

  @@unique([driverId, period])
  @@map("maintenance_fees")
}

model Setting {
  key       String   @id
  value     String
  updatedBy String?  @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at")

  admin Admin? @relation(fields: [updatedBy], references: [id])

  @@map("settings")
}

model Notification {
  id       String    @id @default(uuid())
  userType UserType  @map("user_type")
  userId   String    @map("user_id")
  title    String
  body     String
  data     Json?
  sentAt   DateTime  @default(now()) @map("sent_at")
  readAt   DateTime? @map("read_at")

  @@index([userType, userId])
  @@map("notifications")
}

model AuditLog {
  id        String   @id @default(uuid())
  adminId   String   @map("admin_id")
  action    String
  before    Json?
  after     Json?
  createdAt DateTime @default(now()) @map("created_at")

  admin Admin @relation(fields: [adminId], references: [id])

  @@index([adminId])
  @@map("audit_logs")
}
