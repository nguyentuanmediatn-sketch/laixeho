# Caddyfile triển khai trên Ubuntu VPS cho domain tuannv.site (Auto HTTPS Let's Encrypt)
# Sau này đổi sang domain chính thức: thay tuannv.site -> domain mới, reload Caddy,
# và đổi ô "Tên miền công khai chia sẻ hành trình" trong Web Admin -> Cấu hình & Nhật ký.

api.tuannv.site {
    reverse_proxy 127.0.0.1:3005
}

tuannv.site, www.tuannv.site {
    handle /track/* {
        reverse_proxy 127.0.0.1:3005
    }
    handle /trips/share/* {
        reverse_proxy 127.0.0.1:3005
    }
    handle /uploads/* {
        reverse_proxy 127.0.0.1:3005
    }
    handle /media/* {
        reverse_proxy 127.0.0.1:3005
    }
    handle /socket.io/* {
        reverse_proxy 127.0.0.1:3005
    }

    handle {
        root * /var/www/laixeho/web-admin/dist
        try_files {path} /index.html
        file_server
    }
}
