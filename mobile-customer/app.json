{
  "expo": {
    "name": "NOW TN - Lái Xe Hộ",
    "slug": "lai-xe-ho-khach-hang",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "platforms": ["ios", "android"],
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Ứng dụng cần vị trí của bạn để tự động định vị điểm đón tài xế lái xe hộ."
        }
      ],
      "./plugins/with-cleartext-traffic.js"
    ],
    "ios": {
      "bundleIdentifier": "vn.laixeho.customer",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Ứng dụng cần vị trí của bạn để tự động định vị điểm đón tài xế lái xe hộ."
      }
    },
    "android": {
      "package": "vn.laixeho.customer",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#E51922"
      },
      "permissions": ["ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION", "POST_NOTIFICATIONS", "REQUEST_INSTALL_PACKAGES", "VIBRATE", "INTERNET"]
    }
  }
}
