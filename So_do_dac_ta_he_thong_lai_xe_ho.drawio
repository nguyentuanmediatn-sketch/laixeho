<mxCell id="p1-c3" value="&lt;b&gt;1. KIẾN TRÚC TỔNG THỂ HỆ THỐNG APP LÁI XE HỘ&lt;/b&gt;" style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=1;fontSize=20;align=left;verticalAlign=middle;" vertex="1" parent="p1-1" ><mxGeometry x="30" y="14" width="1500" height="34" as="geometry"/></mxCell>
<mxCell id="p1-c4" value="3 phần mềm người dùng + 1 máy chủ trung tâm + các dịch vụ bên ngoài. Công nghệ ghi trong ngoặc là đề xuất." style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="p1-1" ><mxGeometry x="30" y="46" width="1500" height="24" as="geometry"/></mxCell>
