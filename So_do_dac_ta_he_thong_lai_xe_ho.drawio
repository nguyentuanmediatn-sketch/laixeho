<diagram id="p8" name="8. Cơ sở dữ liệu (ERD)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="820" math="0" shadow="0"><root>
