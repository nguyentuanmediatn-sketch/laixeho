<diagram id="p4" name="4. Điều phối &amp; khóa đơn"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1320" pageHeight="1080" math="0" shadow="0"><root>
<mxCell id="p4-0"/><mxCell id="p4-1" parent="p4-0"/>
<mxCell id="p4-c3" value="&lt;b&gt;4. ĐIỀU PHỐI ĐƠN VÀ KHÓA QUYỀN NHẬN ĐƠN&lt;/b&gt;" style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=1;fontSize=20;align=left;verticalAlign=middle;" vertex="1" parent="p4-1" ><mxGeometry x="30" y="14" width="1260" height="34" as="geometry"/></mxCell>
<mxCell id="p4-c4" value="Gửi đơn lần lượt cho từng tài xế gần nhất. Tài xế từ chối hoặc để hết giờ thì bị khóa và đơn chuyển sang người kế tiếp." style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="p4-1" ><mxGeometry x="30" y="46" width="1260" height="24" as="geometry"/></mxCell>
<mxCell id="p4-c5" value="&lt;b&gt;Đơn mới&lt;/b&gt;&lt;br&gt;(từ App Khách hoặc Admin tạo thủ công)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;" vertex="1" parent="p4-1" ><mxGeometry x="330" y="90" width="340" height="60" as="geometry"/></mxCell>
<mxCell id="p4-c6" value="&lt;b&gt;Lọc tài xế&lt;/b&gt;: đang trực tuyến · đã duyệt · không bị khóa · ví ≥ số dư tối thiểu · không đang chạy chuyến" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;" vertex="1" parent="p4-1" ><mxGeometry x="330" y="180" width="340" height="90" as="geometry"/></mxCell>
<mxCell id="p4-c7" value="Lấy tài xế trong bán kính &lt;b&gt;3–5 km&lt;/b&gt; từ điểm đón, sắp xếp gần → xa" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;" vertex="1" parent="p4-1" ><mxGeometry x="330" y="300" width="340" height="60" as="geometry"/></mxCell>
<mxCell id="p4-c8" value="Còn tài xế chưa gửi?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;" vertex="1" parent="p4-1" ><mxGeometry x="375" y="390" width="250" height="120" as="geometry"/></mxCell>
<mxCell id="p4-c9" value="Gửi đơn cho &lt;b&gt;tài xế gần nhất&lt;/b&gt;&lt;br&gt;Bắt đầu đếm ngược N giây" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;" vertex="1" parent="p4-1" ><mxGeometry x="330" y="545" width="340" height="64" as="geometry"/></mxCell>
<mxCell id="p4-c10" value="Tài xế phản hồi?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;" vertex="1" parent="p4-1" ><mxGeometry x="375" y="640" width="250" height="120" as="geometry"/></mxCell>
<mxCell id="p4-c11" value="&lt;b&gt;Gán tài xế cho đơn&lt;/b&gt;&lt;br&gt;Thông báo khách: tài xế đang đến" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;" vertex="1" parent="p4-1" ><mxGeometry x="330" y="800" width="340" height="64" as="geometry"/></mxCell>
<mxCell id="p4-c12" value="Chuyến bắt đầu" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;" vertex="1" parent="p4-1" ><mxGeometry x="400" y="900" width="200" height="50" as="geometry"/></mxCell>
<mxCell id="p4-c13" value="Báo khách “chưa có tài xế”&lt;br&gt;Đơn hiện trên Web Admin để xử lý" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;" vertex="1" parent="p4-1" ><mxGeometry x="20" y="418" width="300" height="64" as="geometry"/></mxCell>
<mxCell id="p4-c14" value="&lt;b&gt;Khóa tài xế 30–60 phút&lt;/b&gt;&lt;br&gt;Lưu lịch sử vi phạm&lt;br&gt;(bỏ qua tài xế này cho đơn này)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;" vertex="1" parent="p4-1" ><mxGeometry x="800" y="670" width="340" height="80" as="geometry"/></mxCell>
<mxCell id="p4-c15" value="Hết thời gian khóa → hệ thống tự mở lại" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;dashed=1;" vertex="1" parent="p4-1" ><mxGeometry x="800" y="780" width="340" height="56" as="geometry"/></mxCell>
<mxCell id="p4-c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="p4-1" source="p4-c5" target="p4-c6"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="p4-c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="p4-1" source="p4-c6" target="p4-c7"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="p4-c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="p4-1" source="p4-c7" target="p4-c8"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="p4-c19" value="Còn" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="p4-1" source="p4-c8" target="p4-c9"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="p4-c20" value="Hết" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="p4-1" source="p4-c8" target="p4-c13"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="p4-c21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="p4-1" source="p4-c9" target="p4-c10"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="p4-c22" value="Nhận" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="p4-1" source="p4-c10" target="p4-c11"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="p4-c23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="p4-1" source="p4-c11" target="p4-c12"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="p4-c24" value="Từ chối / hết giờ / mất kết nối" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#b85450;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="p4-1" source="p4-c10" target="p4-c14"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="p4-c25" value="thử tài xế kế tiếp" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#b85450;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=1;entryY=0.5;" edge="1" parent="p4-1" source="p4-c14" target="p4-c8"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="p4-c26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="p4-1" source="p4-c14" target="p4-c15"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="p4-c27" value="&lt;b&gt;Tham số Admin cấu hình&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Bán kính: 3–5 km&lt;br&gt;• Thời gian chờ: N giây (vd 30s)&lt;br&gt;• Thời gian khóa: 30–60 phút&lt;br&gt;• Số dư ví tối thiểu&lt;br&gt;&lt;br&gt;&lt;i&gt;Ghi chú: hệ thống không phân biệt mất sóng với cố tình tắt app → hết giờ đều tính là không nhận.&lt;/i&gt;" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="p4-1" ><mxGeometry x="800" y="880" width="340" height="170" as="geometry"/></mxCell>
</root></mxGraphModel></diagram>
<diagram id="p5" name="5. Trạng thái chuyến"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="640" math="0" shadow="0"><root>
<mxCell id="p5-0"/><mxCell id="p5-1" parent="p5-0"/>
<mxCell id="p5-c3" value="&lt;b&gt;5. VÒNG ĐỜI (TRẠNG THÁI) CỦA MỘT CHUYẾN&lt;/b&gt;" style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=1;fontSize=20;align=left;verticalAlign=middle;" vertex="1" parent="p5-1" ><mxGeometry x="30" y="14" width="1660" height="34" as="geometry"/></mxCell>
<mxCell id="p5-c4" value="Mỗi ô là một trạng thái lưu trong cơ sở dữ liệu; mũi tên là hành động làm đổi trạng thái." style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="p5-1" ><mxGeometry x="30" y="46" width="1660" height="24" as="geometry"/></mxCell>
<mxCell id="p5-c5" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=center;fillColor=#333333;" vertex="1" parent="p5-1" ><mxGeometry x="40" y="218" width="50" height="50" as="geometry"/></mxCell>
<mxCell id="p5-c6" value="&lt;b&gt;ĐANG TÌM TÀI XẾ&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;" vertex="1" parent="p5-1" ><mxGeometry x="150" y="200" width="200" height="86" as="geometry"/></mxCell>
<mxCell id="p5-c7" value="&lt;b&gt;ĐÃ NHẬN ĐƠN&lt;/b&gt;&lt;br&gt;tài xế đang đến" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;" vertex="1" parent="p5-1" ><mxGeometry x="480" y="200" width="200" height="86" as="geometry"/></mxCell>
<mxCell id="p5-c8" value="&lt;b&gt;ĐÃ ĐẾN ĐIỂM ĐÓN&lt;/b&gt;&lt;br&gt;đang kiểm tra xe" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;" vertex="1" parent="p5-1" ><mxGeometry x="810" y="200" width="200" height="86" as="geometry"/></mxCell>
<mxCell id="p5-c9" value="&lt;b&gt;ĐANG CHẠY&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;" vertex="1" parent="p5-1" ><mxGeometry x="1140" y="200" width="200" height="86" as="geometry"/></mxCell>
<mxCell id="p5-c10" value="&lt;b&gt;HOÀN THÀNH&lt;/b&gt;&lt;br&gt;đã tính tiền &amp; trừ chiết khấu" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;" vertex="1" parent="p5-1" ><mxGeometry x="1470" y="200" width="200" height="86" as="geometry"/></mxCell>
<mxCell id="p5-c11" value="&lt;b&gt;KHÔNG CÓ TÀI XẾ&lt;/b&gt;&lt;br&gt;chờ Admin xử lý" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;" vertex="1" parent="p5-1" ><mxGeometry x="150" y="430" width="200" height="86" as="geometry"/></mxCell>
<mxCell id="p5-c12" value="&lt;b&gt;ĐÃ HỦY&lt;/b&gt;&lt;br&gt;(lưu lý do hủy)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;" vertex="1" parent="p5-1" ><mxGeometry x="645.0" y="430" width="200" height="86" as="geometry"/></mxCell>
<mxCell id="p5-c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="p5-1" source="p5-c5" target="p5-c6"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="p5-c14" value="Khách gọi / Admin tạo đơn" style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="p5-1" ><mxGeometry x="20" y="160" width="260" height="40" as="geometry"/></mxCell>
<mxCell id="p5-c15" value="Tài xế&lt;br&gt;bấm Nhận" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="p5-1" source="p5-c6" target="p5-c7"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="p5-c16" value="Tài xế&lt;br&gt;bấm Đã đến" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="p5-1" source="p5-c7" target="p5-c8"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="p5-c17" value="Đủ ảnh + video&lt;br&gt;→ Bắt đầu" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="p5-1" source="p5-c8" target="p5-c9"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="p5-c18" value="Ảnh bàn giao&lt;br&gt;→ Hoàn thành" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="p5-1" source="p5-c9" target="p5-c10"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="p5-c19" value="Hết tài xế phù hợp" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#b85450;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="p5-1" source="p5-c6" target="p5-c11"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="p5-c20" value="Khách / Admin hủy" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#b85450;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.25;entryY=0;" edge="1" parent="p5-1" source="p5-c7" target="p5-c12"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="p5-c21" value="Khách / Admin hủy" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#b85450;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.75;entryY=0;" edge="1" parent="p5-1" source="p5-c8" target="p5-c12"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="p5-c22" value="&lt;b&gt;Ghi chú&lt;/b&gt;&lt;br&gt;• Ở trạng thái ĐANG TÌM TÀI XẾ, mỗi lần tài xế từ chối / hết giờ thì đơn vẫn giữ trạng thái và chuyển sang tài xế kế tiếp (xem trang 4).&lt;br&gt;• Khách chỉ hủy được trước khi tài xế nhận xe.&lt;br&gt;• Mọi thay đổi trạng thái đều gửi thông báo đẩy cho khách." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="p5-1" ><mxGeometry x="1140" y="400" width="530" height="150" as="geometry"/></mxCell>
</root></mxGraphModel></diagram>
<diagram id="p6" name="6. Tính tiền"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1080" math="0" shadow="0"><root>
<mxCell id="p6-0"/><mxCell id="p6-1" parent="p6-0"/>
<mxCell id="p6-c3" value="&lt;b&gt;6. CÔNG THỨC TÍNH TIỀN&lt;/b&gt;" style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=1;fontSize=20;align=left;verticalAlign=middle;" vertex="1" parent="p6-1" ><mxGeometry x="30" y="14" width="1340" height="34" as="geometry"/></mxCell>
<mxCell id="p6-c4" value="Áp dụng cho giá dự kiến khi đặt và giá chốt khi hoàn thành chuyến." style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="p6-1" ><mxGeometry x="30" y="46" width="1340" height="24" as="geometry"/></mxCell>
<mxCell id="p6-c5" value="Điểm đón + điểm trả" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;" vertex="1" parent="p6-1" ><mxGeometry x="300" y="90" width="360" height="56" as="geometry"/></mxCell>
<mxCell id="p6-c6" value="Gọi dịch vụ bản đồ – chế độ &lt;b&gt;xe ô tô&lt;/b&gt;, lấy các lộ trình gợi ý" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=center;" vertex="1" parent="p6-1" ><mxGeometry x="300" y="175" width="360" height="70" as="geometry"/></mxCell>
<mxCell id="p6-c7" value="Chọn lộ trình có &lt;b&gt;quãng đường ngắn nhất&lt;/b&gt; → &lt;b&gt;D km&lt;/b&gt; (làm tròn theo quy tắc Bên A)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;" vertex="1" parent="p6-1" ><mxGeometry x="300" y="275" width="360" height="70" as="geometry"/></mxCell>
<mxCell id="p6-c8" value="Giờ đặt đơn trong&lt;br&gt;07:00 – 22:00?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;" vertex="1" parent="p6-1" ><mxGeometry x="340" y="375" width="280" height="130" as="geometry"/></mxCell>
<mxCell id="p6-c9" value="&lt;b&gt;BAN NGÀY&lt;/b&gt;&lt;br&gt;Giá mở cửa = 150.000đ&lt;br&gt;Đơn giá = 10.000đ/km" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;" vertex="1" parent="p6-1" ><mxGeometry x="60" y="545" width="300" height="80" as="geometry"/></mxCell>
<mxCell id="p6-c10" value="&lt;b&gt;BAN ĐÊM&lt;/b&gt;&lt;br&gt;Giá mở cửa = 200.000đ&lt;br&gt;Đơn giá = 15.000đ/km" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;" vertex="1" parent="p6-1" ><mxGeometry x="600" y="545" width="300" height="80" as="geometry"/></mxCell>
<mxCell id="p6-c11" value="D ≤ 5 km?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;" vertex="1" parent="p6-1" ><mxGeometry x="340" y="665" width="280" height="120" as="geometry"/></mxCell>
<mxCell id="p6-c12" value="Giá = Giá mở cửa" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;" vertex="1" parent="p6-1" ><mxGeometry x="60" y="820" width="300" height="60" as="geometry"/></mxCell>
<mxCell id="p6-c13" value="Giá = Giá mở cửa + (D − 5) × Đơn giá" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;" vertex="1" parent="p6-1" ><mxGeometry x="600" y="820" width="300" height="60" as="geometry"/></mxCell>
<mxCell id="p6-c14" value="&lt;b&gt;Chiết khấu&lt;/b&gt; = Giá × % (hoặc số tiền cố định)&lt;br&gt;→ trừ vào ví tài xế khi hoàn thành" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;" vertex="1" parent="p6-1" ><mxGeometry x="300" y="920" width="360" height="64" as="geometry"/></mxCell>
<mxCell id="p6-c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="p6-1" source="p6-c5" target="p6-c6"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="p6-c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="p6-1" source="p6-c6" target="p6-c7"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="p6-c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="p6-1" source="p6-c7" target="p6-c8"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="p6-c18" value="Có" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="p6-1" source="p6-c8" target="p6-c9"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="p6-c19" value="Không" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="p6-1" source="p6-c8" target="p6-c10"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="p6-c20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="p6-1" source="p6-c9" target="p6-c11"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="p6-c21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="p6-1" source="p6-c10" target="p6-c11"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="p6-c22" value="Có" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="p6-1" source="p6-c11" target="p6-c12"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="p6-c23" value="Không" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="p6-1" source="p6-c11" target="p6-c13"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="p6-c24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="p6-1" source="p6-c12" target="p6-c14"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="p6-c25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="p6-1" source="p6-c13" target="p6-c14"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="p6-c26" value="&lt;b&gt;Ví dụ&lt;/b&gt;&lt;br&gt;• 4 km, 14:00 → 150.000đ&lt;br&gt;• 12 km, 14:00 → 150.000 + 7 × 10.000 = &lt;b&gt;220.000đ&lt;/b&gt;&lt;br&gt;• 5 km, 23:00 → 200.000đ&lt;br&gt;• 12 km, 23:00 → 200.000 + 7 × 15.000 = &lt;b&gt;305.000đ&lt;/b&gt;&lt;br&gt;&lt;br&gt;Chiết khấu 20% của chuyến 220.000đ → trừ ví 44.000đ &lt;i&gt;(mức % chỉ là ví dụ)&lt;/i&gt;" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="p6-1" ><mxGeometry x="960" y="175" width="400" height="250" as="geometry"/></mxCell>
<mxCell id="p6-c27" value="&lt;b&gt;Quy tắc cần Bên A chốt&lt;/b&gt;&lt;br&gt;• Khung giờ tính theo &lt;b&gt;thời điểm đặt đơn&lt;/b&gt;&lt;br&gt;• Làm tròn km (vd lên 0,1 km)&lt;br&gt;• Khách đổi điểm trả → tính lại&lt;br&gt;• Mức giá, mốc 5 km, khung giờ: Admin chỉnh được" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="p6-1" ><mxGeometry x="960" y="460" width="400" height="170" as="geometry"/></mxCell>
</root></mxGraphModel></diagram>
<diagram id="p7" name="7. Ví &amp; phí duy trì"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="900" math="0" shadow="0"><root>
<mxCell id="p7-0"/><mxCell id="p7-1" parent="p7-0"/>
<mxCell id="p7-c3" value="&lt;b&gt;7. VÍ TÀI XẾ VÀ PHÍ DUY TRÌ&lt;/b&gt;" style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=1;fontSize=20;align=left;verticalAlign=middle;" vertex="1" parent="p7-1" ><mxGeometry x="30" y="14" width="1500" height="34" as="geometry"/></mxCell>
<mxCell id="p7-c4" value="Khách trả tiền chuyến trực tiếp cho tài xế. Ví tài xế là ví ký quỹ để hệ thống trừ chiết khấu." style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="p7-1" ><mxGeometry x="30" y="46" width="1500" height="24" as="geometry"/></mxCell>
