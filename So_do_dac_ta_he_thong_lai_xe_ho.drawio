<mxCell id="p7-c6" value="&lt;b&gt;B. TRỪ CHIẾT KHẤU SAU CHUYẾN&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;align=center;" vertex="1" parent="p7-1" ><mxGeometry x="560" y="90" width="440" height="44" as="geometry"/></mxCell>
<mxCell id="p7-c7" value="&lt;b&gt;C. PHÍ DUY TRÌ 200.000đ/THÁNG&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;align=center;" vertex="1" parent="p7-1" ><mxGeometry x="1080" y="90" width="440" height="44" as="geometry"/></mxCell>
<mxCell id="p7-c8" value="Tài xế chuyển khoản vào tài khoản Bên A (theo hướng dẫn trong app)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;" vertex="1" parent="p7-1" ><mxGeometry x="80" y="165" width="360" height="60" as="geometry"/></mxCell>
